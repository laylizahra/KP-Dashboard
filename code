            with st.spinner("Menjalankan STL Decomposition..."):
                stl    = STL(prices, period=stl_period,
                             robust=True)
                result = stl.fit()
                trend    = result.trend
                seasonal = result.seasonal
                residual = result.resid
                scaler   = MinMaxScaler(
                    feature_range=(-1, 1))
                resid_sc = scaler.fit_transform(
                    residual.reshape(-1, 1))

                st.session_state.trend    = trend
                st.session_state.seasonal = seasonal
                st.session_state.residual = residual
                st.session_state.resid_sc = resid_sc
                st.session_state.scaler   = scaler
                st.session_state.LOOK_BACK = look_back

            # Sequences
            def make_seq(data, lb):
                X, y = [], []
                for i in range(lb, len(data)):
                    X.append(data[i-lb:i, 0])
                    y.append(data[i, 0])
                return np.array(X), np.array(y)

            X, y  = make_seq(resid_sc, look_back)
            split = int(len(X) * train_split / 100)
            X_train = X[:split].reshape(-1, look_back, 1)
            X_test  = X[split:].reshape(-1, look_back, 1)
            y_train = y[:split]
            train_idx = np.arange(
                look_back, look_back + len(X_train))
            test_idx  = np.arange(
                look_back + split,
                look_back + split + len(X_test))

            st.session_state.split     = split
            st.session_state.train_idx = train_idx
            st.session_state.test_idx  = test_idx

            # Model
            model = Sequential([
                Bidirectional(
                    LSTM(lstm_unit1,
                         return_sequences=True),
                    input_shape=(look_back, 1)),
                Dropout(dropout),
                Bidirectional(
                    LSTM(lstm_unit2,
                         return_sequences=False)),
                Dropout(dropout),
                Dense(32, activation="relu"),
                Dense(1)
            ])
            model.compile(
                optimizer="adam", loss="huber")

            # Progress
            st.markdown("""
            <div style='font-weight:700; color:#1a1a2e;
                        margin:1rem 0 0.5rem'>
                Progress Training:
            </div>
            """, unsafe_allow_html=True)

            prog_bar   = st.progress(0)
            status_txt = st.empty()
            chart_spot = st.empty()
            train_losses, val_losses = [], []

            class CB(Callback):
                def on_epoch_end(self, epoch, logs=None):
                    logs = logs or {}
                    tl = logs.get("loss", 0)
                    vl = logs.get("val_loss", 0)
                    train_losses.append(tl)
                    val_losses.append(vl)
                    prog = min(
                        (epoch+1)/max_epoch, 1.0)
                    prog_bar.progress(prog)
                    status_txt.markdown(
                        f"**Epoch {epoch+1}/{max_epoch}** "
                        f"&nbsp;|&nbsp; "
                        f"Train Loss: **{tl:.5f}** "
                        f"&nbsp;|&nbsp; "
                        f"Val Loss: **{vl:.5f}**"
                    )
                    if (epoch+1) % 10 == 0 and epoch > 5:
                        fig_l, ax_l = plt.subplots(
                            figsize=(8, 2.5))
                        fig_l.patch.set_facecolor("white")
                        ax_l.plot(train_losses,
                                  color="#1a1a2e",
                                  lw=2,
                                  label="Train Loss")
                        ax_l.plot(val_losses,
                                  color="#FFD700",
                                  lw=2,
                                  label="Val Loss")
                        ax_l.set_facecolor("#f8f8f8")
                        ax_l.legend(fontsize=9)
                        ax_l.grid(alpha=0.2)
                        ax_l.set_xlabel(
                            "Epoch", fontsize=9)
                        plt.tight_layout()
                        chart_spot.pyplot(fig_l)
                        plt.close()

            es = EarlyStopping(
                monitor="val_loss",
                patience=patience,
                restore_best_weights=True)

            history = model.fit(
                X_train, y_train,
                epochs=max_epoch,
                batch_size=batch_size,
                validation_split=0.1,
                callbacks=[es, CB()],
                verbose=0)

            prog_bar.progress(1.0)
            best_ep = np.argmin(
                history.history["val_loss"]) + 1

            # Hitung prediksi
            tr_pred = scaler.inverse_transform(
                model.predict(X_train, verbose=0))
            te_pred = scaler.inverse_transform(
                model.predict(X_test, verbose=0))

            tr_full = (trend[train_idx]
                       + seasonal[train_idx]
                       + tr_pred.flatten())
            te_full = (trend[test_idx]
                       + seasonal[test_idx]
                       + te_pred.flatten())

            y_tr = prices[train_idx]
            y_te = prices[test_idx]

            def mape_fn(a, p):
                return np.mean(
                    np.abs((a-p)/a))*100

            st.session_state.model         = model
            st.session_state.model_trained = True
            st.session_state.train_history = history
            st.session_state.results = {
                "train_pred" : tr_full,
                "test_pred"  : te_full,
                "y_train"    : y_tr,
                "y_test"     : y_te,
                "mae"   : mean_absolute_error(
                    y_te, te_full),
                "rmse"  : np.sqrt(mean_squared_error(
                    y_te, te_full)),
                "mape"  : mape_fn(y_te, te_full),
                "r2"    : r2_score(y_te, te_full),
                "best_epoch": best_ep,
            }

            status_txt.markdown(f"""
            <div class='status-success'>
                ✅ Training selesai! &nbsp;
                Best epoch: <b>{best_ep}</b> &nbsp;|&nbsp;
                Val Loss: <b>
                {min(history.history['val_loss']):.5f}
                </b>
            </div>
            """, unsafe_allow_html=True)


        fut_sc   = []

        for _ in range(n_weeks):
            nxt = model.predict(last_seq, verbose=0)[0, 0]
            nxt = np.clip(nxt, -0.5, 0.5)
            noise = np.random.normal(0, 0.02)
            nxt   = np.clip(nxt + noise, -0.6, 0.6)
            fut_sc.append(nxt)
            last_seq = np.roll(last_seq, -1, axis=1)
            last_seq[0, -1, 0] = nxt

